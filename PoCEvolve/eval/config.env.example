# PoCEvolve Evaluation Environment Configuration
# Copy this file to .env and fill in your values:
#   cp config.env.example .env

# ─── Required ──────────────────────────────────────────────

# Path to dataset text file (one vulnerability ID per line)
# Available datasets in PoCEvolve/datasets/:
#   SecBench.js.PoCGen.vfc.190  (recommended for baseline, ~2-4h)
#   SecBench.js.PoCGen.559      (full eval, ~6-12h+)
DATASET="PoCEvolve/datasets/SecBench.js.PoCGen.vfc.190"

# ─── LLM Endpoint ────────────────────────────────────────

MODEL_NAME="qwen36"
API_BASE="http://localhost:11434/v1"
API_KEY="ollama"  # Placeholder for Ollama (no key required)

# ─── Optimization Loop Parameters ─────────────────────────

# Max iterations per attempt (higher = more LLM calls but potentially better exploits)
ITERATION=5

# Number of candidates evaluated in each minibatch during evolution
MINIBATCH_SIZE=3

# Random seed for reproducibility
SEED=42

# ─── Timing ──────────────────────────────────────────────

# Command timeout (seconds) for running exploits in the testbed container
COMMAND_TIMEOUT=60

# ─── Paths ───────────────────────────────────────────────

# Testbed directory containing patched npm packages per vulnerability
TESTBED_DIR="testbed"

# Output directory for transcripts and profiling data
GEPA_LOG_DIR="logs"

# Glob pattern for finding previously generated VFC files
GENERATED_VFC_GLOB="./logs/vfcs.generated.*.jsonl"

# ─── PoCGen Training Data (evolver_pocgen only) ──────────

# Path to converted PoCGen training data for the pocgen seeding mode
TRAINING_DATA="data/pocgen_training.json"
